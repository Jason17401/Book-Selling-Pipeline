# Book Selling Pipeline settings.
# setup.bat copies this file to .env (SETUP.md step 1). Fill in the TELEGRAM part (TELEGRAM_SETUP.md) and the free
# API keys (API_KEYS.md: GOOGLE_BOOKS_API_KEY, TAVILY_API_KEY, LANGSEARCH_API_KEY, IMGBB_API_KEY).
# Everything else works as it is. Lines starting with # are comments. Restart the bot after changing anything.

# ===================== 1. Telegram bot (required) =====================
# From @BotFather - see TELEGRAM_SETUP.md
TELEGRAM_BOT_TOKEN=
# Your Telegram user id (the bot shows it when you send /start). Only these ids can use the bot; blank = ANYONE who
# finds the bot could send it photos. Several people: 12345,67890
ALLOWED_USER_IDS=
# Seconds to wait for Telegram before retrying a photo download. Raise it on a slow connection.
BOT_TIMEOUT=30

# ===================== 2. Photos =====================
# Books per set: 1 front photo + this many back photos.
SET_SIZE=8
# How the books lie in the FRONT photo, as rows x columns when the photo is upright (2x4 = two rows of four).
# Book 1 is top-left, then along the row; send the back photos in that order. Must hold SET_SIZE books.
GRID=2x4
# Degrees clockwise to turn the FRONT photo upright: 0, 90, 180 or 270. Find yours: python -m pipeline orient <photo>
# (Barcode photos are never turned - barcodes read in any direction.)
ROTATE=0
# Part of the front photo the books cover, as left,top,right,bottom fractions (ignore clutter around them), e.g. 0.08,0,0.93,1
REGION=0,0,1,1
# Each book's cover is cut out of the front photo: auto = find each book in the picture; grid = equal cells
SEGMENT=auto
# Table kept around each cut-out cover, as a fraction of the book's size (0.04 = 4% on every side; 0 = none)
SEGMENT_MARGIN=0.04

# ===================== 3. Book details (title, author, genre ...) =====================
# Optional but recommended: Google Books key (free, 1,000 look-ups a day). API_KEYS.md says how to get it.
GOOGLE_BOOKS_API_KEY=
# Stop using Google after this many calls a day (Google's limit is 1,000, reset at midnight US Pacific time).
GOOGLE_DAILY_LIMIT=950
# Your email: Open Library asks programs to identify themselves.
CONTACT_EMAIL=you@example.com
# Where book details come from, asked in order (later ones only fill gaps; a Chinese title/genre replaces an English one).
#   google  Google Books        ncl  國家圖書館 全國新書資訊網 (catalogue record: price + subject heading)
#   eslite, books_tw  the shops 誠品 / 博客來 (category = genre)        openlibrary  Open Library
# Taiwanese ISBNs (978-957 / 978-986 / 978-626): the Chinese sources first, Google (often English only) after them:
BOOK_PROVIDERS_TW=ncl,eslite,books_tw,google,openlibrary
# All other ISBNs:
BOOK_PROVIDERS=openlibrary,openlibrary_search,google

# ===================== 4. Market price of a new copy =====================
# Where to look for the list price (定價) of a new, printed copy. Always tried in this order; remove a name to skip it:
#   barcode           the small price barcode next to the ISBN barcode on the book - first choice
#   ncl               Taiwan's ISBN agency: the price the publisher registered (knows out-of-print books)
#   eslite, books_tw  the shops 誠品 and 博客來
MARKET_PROVIDERS=barcode,ncl,eslite,books_tw
# How the shops are searched:
#   isbn, isbn10  the ISBN in the shop's search box      title  the title (also finds other editions of the book)
#   web           a web search (needs a key below)
MARKET_SEARCH=isbn,isbn10,title,web
# When no copy with YOUR ISBN exists: 1 = use another PRINTED edition of the same book (same title and author),
# marked "similar" in the market_match column. E-books and audiobooks are never used.
MARKET_SIMILAR=1

# Web search - optional, finds out-of-print books the shops' own search hides.
# Put in a key from one or both services; with both, Tavily is used first and LangSearch only if Tavily fails or
# is used up. Each search is made once.
#   Tavily      https://tavily.com      free: 1,000 credits a month (a search = 2), no credit card
#   LangSearch  https://langsearch.com  free: a daily allowance
TAVILY_API_KEY=
LANGSEARCH_API_KEY=
# Stop web searches after this many credits a month (a Tavily search costs 2; stays inside its free 1,000). 0 = none.
WEB_SEARCH_MONTHLY_LIMIT=900

# ===================== 5. Your price and condition =====================
# Your price = market price x PRICE_RATIO (0.4, 40% and 40 all mean 40%), in the market price's own currency.
PRICE_RATIO=0.4
# 1 = fill an empty price automatically from the market price (a price you typed is never changed).
AUTO_PRICE=1
# Rounding per currency (* = any other): TWD to whole dollars, others to 0.50.
PRICE_ROUND=TWD:1,*:0.5
# Currency for a price typed without one.
DEFAULT_CURRENCY=TWD
# Condition of every new book unless a caption says otherwise (DATA_AND_STATUSES.md, Condition grades):
#   new 全新 | as_new 近全新 | good 良好 | fair 普通 | poor 差強人意   (TAAZE's grades A-E: DATA_AND_STATUSES.md)
DEFAULT_CONDITION=as_new
# A price outside this range is flagged as a probable typo.
MIN_PRICE=1
MAX_PRICE=500
# 1 = show the price of a new copy (新書定價 NT$250) next to each book in the listing text.
LISTING_SHOW_MARKET=1

# ===================== 6. Selling on Shopee - DAILY_USE.md "Sell on Shopee" =====================
# Whole-set discount: a set's price = the sum of its books' prices minus this (20% = 8 折; 0 = no discount).
# Each product's own discount - or its price, the discount then follows - can be changed in the review window
# (Sell products).
SET_DISCOUNT=20%
# Shopee's bulk-upload template: blank = the Excel file in data\listings\shopee\template\ (any name - just put the
# downloaded file there), or a path to a file / folder. Required: without it no upload file is made. (Weight and
# parcel size are left empty in it - optional, and we don't have them.)
SHOPEE_TEMPLATE=
# 分類代碼 (category ID) the products are listed in. Shopee has no "used books" category - books go by subject, e.g.
# 101573 其他書籍 Other Books, 101541 繪本童書 Picture & Children's Books, 101563 心理勵志書籍 Psychology & Self-Help.
# Optional. Blank = the category in the template's category list whose name contains SHOPEE_CATEGORY_NAME; if there
# is none, the column is left blank and Shopee suggests a category for each product (check it under 尚未刊登).
SHOPEE_CATEGORY_ID=
SHOPEE_CATEGORY_NAME=其他書籍
# Delivery options to switch ON (as the template's columns name them); every other one is switched off.
SHOPEE_LOGISTICS=7-ELEVEN,全家,萊爾富,OK,蝦皮店到店
# 較長備貨天數 - days you need before shipping (blank = Shopee's normal handling time)
SHOPEE_DAYS_TO_SHIP=
# Photos per product (Shopee: 9). Photo 1 = the numbered set photo, then each book's front + back.
SHOPEE_MAX_IMAGES=9
# Your shop's number (in your shop's link: shopee.tw/shop/<number>) - to build each product's link.
SHOPEE_SHOP_ID=
# Password of Shopee's order report (usually the last 6 digits of your phone), so it opens automatically.
SHOPEE_EXPORT_PASSWORD=
# Photos online on ImgBB (SETUP.md "Photo links"), so the upload file carries their links and you drag no photos into
# Seller Center. Free, no card: imgbb.com > sign up > api.imgbb.com > Get API key. Each photo is uploaded once.
# Blank = no links: you add the photos by hand.
IMGBB_API_KEY=

# ===================== 7. Advanced (leave as they are unless something is wrong) =====================
# Barcode readers to try, and how hard: fast | normal | max
DECODERS=zxing,zbar,opencv
DECODE_EFFORT=normal
# Book details: stop asking more sources once these fields are filled
LOOKUP_STOP_WHEN=title,author,publisher,year,genre
# How Google is asked: id = via the book's Google id (finds more), isbn = isbn: search, isbn10, plain
GOOGLE_STEPS=id,isbn
# Remember answers this many days (found / not found), so re-running costs nothing
LOOKUP_CACHE_DAYS=180
LOOKUP_CACHE_MISS_DAYS=7
# Seconds between requests to the same shop/website (be polite; keep >= 2)
SCRAPE_DELAY=3
# Use only one engine order of your own, e.g. langsearch,tavily (blank = tavily, then langsearch)
WEB_SEARCH=
# Web search wording, tried in order until the book is found: isbn = "<isbn>" on eslite + books.com.tw at once,
# site = "<isbn> site:eslite.com", shop = "eslite <isbn>"
WEB_QUERIES=isbn,site,shop
# books.com.tw: product pages checked per title search
MARKET_TITLE_PAGES=3
# eslite: 1 = one more request per book for the page count
ESLITE_DETAILS=0
# Where books.csv, photos and listings are kept
DATA_DIR=data
# 1 = plain progress lines in the bot window (if it shows odd characters like ←[1A)
PLAIN_PROGRESS=
# python -m pipeline ingest only: skip inbox files changed in the last N seconds (still syncing)
SETTLE_SECONDS=5
